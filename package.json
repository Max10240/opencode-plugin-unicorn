{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@max10240/opencode-plugin-unicorn-workspace",
  "version": "0.0.1",
  "private": true,
  "description": "Monorepo for personal OpenCode plugins",
  "type": "module",
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "test": "bun run --workspaces --if-present test",
    "typecheck": "bun run --workspaces --if-present typecheck",
    "check": "bun run typecheck && bun run test",
    "publish:all": "npm version --ws patch && npm publish --ws",
    "postpublish:all": "git commit -Am 'chore: publish'",
    "publish:all:prerelease": "npm run public:all -- --tag=prerelease"
  }
}
