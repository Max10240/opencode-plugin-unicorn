{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@max10240/opencode-plugin-unicorn-workspace",
  "version": "0.0.1",
  "private": true,
  "description": "Monorepo for OpenCode plugins",
  "type": "module",
  "packageManager": "bun@1.4.4",
  "engines": {
    "bun": ">=1.4.4 <2"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "prepare": "node scripts/install-hooks.mjs",
    "sync:rules": "node scripts/sync-recommended-rules.mjs",
    "check:versions": "node scripts/check-versions.mjs",
    "sync:versions": "node scripts/sync-plugin-dependencies.mjs",
    "test:versions": "bun test test/versions.test.ts",
    "test:rules-sync": "bun test test/rules-sync.test.ts test/commands-sync.test.ts",
    "build": "node scripts/workflow.mjs build",
    "test": "node scripts/workflow.mjs test",
    "test:unit": "node scripts/workflow.mjs unit",
    "test:e2e": "node scripts/workflow.mjs e2e",
    "typecheck": "node scripts/workflow.mjs typecheck",
    "test:packaged": "node scripts/workflow.mjs packaged",
    "check:quick": "node scripts/workflow.mjs quick",
    "check:release": "node scripts/workflow.mjs check --fresh",
    "check": "node scripts/workflow.mjs check",
    "shadow:update": "node scripts/unicorn-shadow.mjs update",
    "shadow:status": "node scripts/unicorn-shadow.mjs status",
    "shadow:verify": "node scripts/unicorn-shadow.mjs verify",
    "shadow:clean": "node scripts/unicorn-shadow.mjs clean",
    "login:npm": "node scripts/npm-login.mjs",
    "trust:npm": "node scripts/npm-trust.mjs",
    "release": "node scripts/release.mjs"
  },
  "devDependencies": { "jsonc-parser": "^3.3.1", "yaml": "^2.8.1" }
}
