{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@max10240/opencode-plugin-unicorn-workspace",
  "version": "0.0.1",
  "private": true,
  "description": "Monorepo for personal OpenCode plugins",
  "type": "module",
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "test": "bun run --cwd packages/opencode-plugin-unicorn test",
    "typecheck": "bun run --cwd packages/opencode-plugin-unicorn typecheck",
    "check": "bun run typecheck && bun run test"
  }
}
