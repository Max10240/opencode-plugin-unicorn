{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@max10240/opencode-plugin-unicorn-workspace",
  "version": "0.0.1",
  "private": true,
  "description": "Monorepo for personal OpenCode plugins",
  "type": "module",
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "prepare": "node scripts/install-hooks.mjs",
    "sync:rules": "node scripts/sync-recommended-rules.mjs",
    "check:versions": "node scripts/check-versions.mjs",
    "sync:versions": "node scripts/sync-plugin-dependencies.mjs",
    "test:versions": "bun test test/versions.test.ts",
    "test:rules-sync": "bun test test/rules-sync.test.ts test/commands-sync.test.ts",
    "build": "node scripts/workflow.mjs build",
    "test": "node scripts/workflow.mjs test",
    "test:unit": "node scripts/workflow.mjs unit",
    "test:e2e": "node scripts/workflow.mjs e2e",
    "typecheck": "node scripts/workflow.mjs typecheck",
    "test:packaged": "node scripts/workflow.mjs packaged",
    "test:packaged:fresh": "node scripts/workflow.mjs packaged --fresh",
    "check:fast": "node scripts/workflow.mjs fast",
    "check:full": "node scripts/workflow.mjs check",
    "check:fresh": "node scripts/workflow.mjs check --fresh",
    "check": "node scripts/workflow.mjs check",
    "publish:all": "node scripts/publish.mjs",
    "publish:all:dry-run": "node scripts/publish.mjs --dry-run",
    "publish:all:prerelease": "npm run publish:all -- --tag=prerelease"
  },
  "devDependencies": { "jsonc-parser": "^3.3.1" }
}
