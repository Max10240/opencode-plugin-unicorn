{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@max10240/opencode-plugin-recomended-opencode-config",
  "version": "1.0.37",
  "description": "Merge recommended OpenCode rules and disable OpenAI response storage",
  "type": "module",
  "exports": {
    ".": "./dist/src/index.js",
    "./tui": "./dist/src/tui.js"
  },
  "scripts": {
    "test": "bun test test/*.test.ts && bun test --conditions=browser --preload @opentui/solid/preload test/tui",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json && bun build.mjs",
    "prepack": "node ../../scripts/sync-recommended-rules.mjs && npm run build"
  },
  "files": [
    "dist/**/*.js",
    "README.md",
    "README.zh-CN.md"
  ],
  "license": "MIT",
  "dependencies": {
    "jsonc-parser": "^3.3.1",
    "marked": "^18.0.14"
  },
  "devDependencies": {
    "@types/bun": "^1.3.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.8.2",
    "@opencode/plugin": "^2.2.7",
    "@opentui/core": "^0.5.10",
    "@opentui/solid": "^0.5.10",
    "solid-js": "^1.9.15"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Max10240/opencode-plugin-unicorn.git",
    "directory": "packages/opencode-plugin-recomended-opencode-config"
  },
  "peerDependencies": {
    "@opencode/plugin": "^2.2.7",
    "@opentui/core": ">=0.5.8",
    "@opentui/solid": ">=0.5.8",
    "solid-js": ">=1.9.0"
  },
  "peerDependenciesMeta": {
    "@opencode/plugin": {
      "optional": true
    },
    "@opentui/core": {
      "optional": true
    },
    "@opentui/solid": {
      "optional": true
    },
    "solid-js": {
      "optional": true
    }
  }
}
