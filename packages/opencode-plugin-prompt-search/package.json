{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@max10240/opencode-plugin-prompt-search",
  "version": "1.0.3",
  "description": "Fast reverse-search for prompts across OpenCode sessions",
  "type": "module",
  "exports": {
    ".": "./dist/src/index.js",
    "./tui": "./dist/src/tui.js"
  },
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json && bun build.mjs",
    "prepack": "npm run build"
  },
  "files": [
    "dist/**/*.js",
    "README.md"
  ],
  "keywords": [
    "opencode",
    "opencode-plugin",
    "prompt-search"
  ],
  "license": "ISC",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "dependencies": {
    "@opencode/plugin": "^2.0.9"
  },
  "peerDependencies": {
    "@opentui/core": ">=0.5.8",
    "@opentui/solid": ">=0.5.8",
    "solid-js": ">=1.9.0"
  },
  "devDependencies": {
    "@copilotkit/aimock": "^1.42.1",
    "@opencode/plugin": "^2.0.9",
    "@opentui/core": "^0.5.10",
    "@opentui/solid": "^0.5.10",
    "@types/bun": "^1.3.0",
    "@types/node": "^22.0.0",
    "solid-js": "^1.9.15",
    "typescript": "^5.8.2"
  }
}
