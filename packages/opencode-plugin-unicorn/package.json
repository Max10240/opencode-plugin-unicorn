{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@max10240/opencode-plugin-unicorn",
  "version": "1.0.13",
  "description": "Personal OpenCode plugin features",
  "type": "module",
  "exports": {
    ".": "./dist/src/index.js",
    "./tui": "./dist/src/tui.js"
  },
  "scripts": {
    "test": "bun test test/*.test.ts && bun test --conditions=browser --preload @opentui/solid/preload test/tui",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json && node build.mjs",
    "prepack": "node ../../scripts/sync-plugin-dependencies.mjs && node ../../scripts/sync-recommended-rules.mjs && npm run build"
  },
  "files": [
    "dist/**/*.js",
    "README.md"
  ],
  "keywords": [
    "opencode",
    "opencode-plugin"
  ],
  "author": "",
  "license": "ISC",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "dependencies": {
    "@max10240/opencode-plugin-image-gen": "1.0.13",
    "@max10240/opencode-plugin-prompt-search": "1.0.13",
    "@max10240/opencode-plugin-recomended-opencode-config": "1.0.13",
    "@max10240/opencode-plugin-send-message-across-sessions": "1.0.13",
    "@max10240/opencode-plugin-sensitive-encrypt": "1.0.13",
    "@max10240/opencode-plugin-sensitive-protection": "1.0.13",
    "@max10240/opencode-plugin-session-search": "1.0.13",
    "@max10240/opencode-plugin-show-img": "1.0.13",
    "@opencode/plugin": "^2.0.9"
  },
  "peerDependencies": {
    "@opentui/core": ">=0.5.8",
    "@opentui/solid": ">=0.5.8",
    "solid-js": ">=1.9.0"
  },
  "devDependencies": {
    "jsonc-parser": "^3.3.1",
    "@copilotkit/aimock": "^1.42.1",
    "@opentui/core": "^0.5.10",
    "@opentui/solid": "^0.5.10",
    "@types/bun": "^1.3.0",
    "@types/node": "^22.0.0",
    "solid-js": "^1.9.15",
    "typescript": "^5.8.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Max10240/opencode-plugin-unicorn.git",
    "directory": "packages/opencode-plugin-unicorn"
  }
}
