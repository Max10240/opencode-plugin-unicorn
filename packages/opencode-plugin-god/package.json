{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@max10240/opencode-plugin-god",
  "version": "1.0.39",
  "description": "Adds a god agent whose system prompt is selected by model ID",
  "type": "module",
  "exports": {
    ".": "./dist/index.js"
  },
  "scripts": {
    "test": "bun test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "prepack": "node ../../scripts/sync-recommended-rules.mjs && npm run build"
  },
  "files": [
    "dist/**/*.js",
    "README.md",
    "README.zh-CN.md"
  ],
  "keywords": [
    "opencode",
    "opencode-plugin",
    "agent",
    "system-prompt"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@opencode/plugin": "^2.2.7"
  },
  "devDependencies": {
    "@types/bun": "^1.3.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.8.2",
    "@opencode/plugin": "^2.2.7"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Max10240/opencode-plugin-unicorn.git",
    "directory": "packages/opencode-plugin-god"
  },
  "peerDependenciesMeta": {
    "@opencode/plugin": {
      "optional": true
    }
  }
}
