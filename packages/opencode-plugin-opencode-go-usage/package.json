{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@max10240/opencode-plugin-opencode-go-usage",
  "version": "1.0.31",
  "description": "Show OpenCode Go 5-hour, weekly and monthly usage for every signed-in account in the TUI",
  "type": "module",
  "exports": {
    ".": "./dist/src/index.js",
    "./tui": "./dist/src/tui.js"
  },
  "scripts": {
    "test": "bun test test/*.test.ts && bun test --conditions=browser --preload @opentui/solid/preload test/tui",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json && bun build.mjs",
    "prepack": "node ../../scripts/sync-recommended-rules.mjs && npm run build"
  },
  "files": [
    "dist/**/*.js",
    "README.md",
    "README.zh-CN.md"
  ],
  "keywords": [
    "opencode",
    "opencode-plugin",
    "opencode-go",
    "usage"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@opentui/core": ">=0.5.10",
    "@opentui/solid": ">=0.5.10",
    "solid-js": ">=1.9.0",
    "@opencode/plugin": "^2.2.7"
  },
  "devDependencies": {
    "@opentui/core": "^0.5.10",
    "@opentui/solid": "^0.5.10",
    "@types/bun": "^1.3.0",
    "@types/node": "^22.0.0",
    "solid-js": "^1.9.15",
    "typescript": "^5.8.2",
    "@opencode/plugin": "^2.2.7"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Max10240/opencode-plugin-unicorn.git",
    "directory": "packages/opencode-plugin-opencode-go-usage"
  },
  "peerDependenciesMeta": {
    "@opencode/plugin": {
      "optional": true
    },
    "@opentui/core": {
      "optional": true
    },
    "@opentui/solid": {
      "optional": true
    },
    "solid-js": {
      "optional": true
    }
  }
}
